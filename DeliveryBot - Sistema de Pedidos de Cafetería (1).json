    {
      "parameters": {
        "jsCode": "const session = $input.first().json;\nconst cart = JSON.parse(session.carrito_temporal || \"[]\");\n\nif (cart.length === 0) {\n  return [{ json: { message: \"🛒 Tu carrito está vacío.\\n\\nUsa /menu para ver los productos disponibles.\" } }];\n}\n\nlet message = \"🛒 *TU CARRITO*\\n\\n\";\nlet total = 0;\n\nfor (const item of cart) {\n  const subtotal = parseFloat(item.precio) * item.cantidad;\n  total += subtotal;\n  message += `${item.cantidad}x ${item.nombre} - $${subtotal.toFixed(2)}\\n`;\n}\n\nmessage += `\\n💰 *Total: $${total.toFixed(2)}*\\n\\n`;\nmessage += \"✅ Usa /pedido para confirmar tu orden.\";\n\nreturn [{ json: { message, total } }];"
      },
