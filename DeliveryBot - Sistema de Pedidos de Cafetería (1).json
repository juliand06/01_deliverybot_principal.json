      "parameters": {
        "jsCode": "const text = $input.first().json.message.text;\nconst match = text.match(/^(\\d+)\\s*x\\s*(\\d+)$/i);\n\nif (!match) {\n  return [{ json: { error: \"Formato inválido\" } }];\n}\n\nconst productId = parseInt(match[1]);\nconst quantity = parseInt(match[2]);\n\nreturn [{ json: { productId, quantity, userId: $input.first().json.message.chat.id } }];"
      },
