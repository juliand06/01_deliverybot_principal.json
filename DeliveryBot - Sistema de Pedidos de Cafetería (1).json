    {
      "parameters": {
        "jsCode": "const orders = $input.all();\n\nlet totalSales = 0;\nconst productCount = {};\nconst hourCount = {};\n\nfor (const order of orders) {\n  totalSales += parseFloat(order.json.total_pago || 0);\n  \n  const details = JSON.parse(order.json.detalles_pedido || \"[]\");\n  for (const item of details) {\n    productCount[item.nombre] = (productCount[item.nombre] || 0) + item.cantidad;\n  }\n  \n  const hour = order.json.hora ? order.json.hora.split(\":\")[0] : \"00\";\n  hourCount[hour] = (hourCount[hour] || 0) + 1;\n}\n\nconst topProduct = Object.entries(productCount).sort((a, b) => b[1] - a[1])[0] || [\"N/A\", 0];\nconst peakHour = Object.entries(hourCount).sort((a, b) => b[1] - a[1])[0] || [\"00\", 0];\n\nreturn [{\n  json: {\n    fecha: new Date().toISOString().split(\"T\")[0],\n    total_pedidos: orders.length,\n    total_ventas: totalSales.toFixed(2),\n    producto_estrella: topProduct[0],\n    cantidad_estrella: topProduct[1],\n    hora_pico: peakHour[0] + \":00\",\n    pedidos_hora_pico: peakHour[1]\n  }\n}];"
      },
