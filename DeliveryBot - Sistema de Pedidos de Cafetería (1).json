    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst categories = {};\nfor (const item of items) {\n  const cat = item.json.categoria || \"Otros\";\n  if (!categories[cat]) categories[cat] = [];\n  categories[cat].push(item.json);\n}\n\nlet message = \"🍽️ *MENÚ DELIVERYBOT*\\n\\n\";\n\nfor (const [category, products] of Object.entries(categories)) {\n  message += `📋 *${category}*\\n`;\n  for (const product of products) {\n    message += `${product.id_producto}. ${product.nombre} - $${product.precio}\\n`;\n    message += `   _${product.descripcion}_\\n`;\n  }\n  message += \"\\n\";\n}\n\nmessage += \"💬 Para ordenar, escribe el número del producto y la cantidad.\\nEjemplo: 1 x 2 (2 cafés)\";\n\nreturn [{ json: { message } }];"
      },
