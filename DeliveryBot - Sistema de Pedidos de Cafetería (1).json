      "parameters": {
        "jsCode": "const callback = $input.first().json.callback_query;\nconst data = callback.data;\n\nlet message = \"\";\n\nif (data === \"view_cart\") {\n  message = \"🛒 Usa /carrito para ver tu carrito completo.\";\n} else if (data === \"confirm_order\") {\n  message = \"✅ Usa /pedido para confirmar tu orden.\";\n} else {\n  message = \"❓ Opción no reconocida.\";\n}\n\nreturn [{ json: { message, chat_id: callback.message.chat.id } }];"
      },
