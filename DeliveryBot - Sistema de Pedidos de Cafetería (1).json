      "parameters": {
        "jsCode": "const orderInfo = $(\"Generate Order ID\").item.json;\nconst sessionData = $input.first().json;\nconst cart = JSON.parse(sessionData.carrito_temporal || \"[]\");\n\nlet total = 0;\nfor (const item of cart) {\n  total += parseFloat(item.precio) * item.cantidad;\n}\n\nreturn [{\n  json: {\n    id_pedido: orderInfo.id_pedido,\n    id_usuario: orderInfo.id_usuario,\n    detalles_pedido: JSON.stringify(cart),\n    total_pago: total.toFixed(2),\n    estado: orderInfo.estado,\n    fecha: orderInfo.fecha,\n    hora: orderInfo.hora\n  }\n}];"
      },
